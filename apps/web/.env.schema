# Convex
#@required
NEXT_PUBLIC_CONVEX_URL=exec(`aws-vault exec split-bill-dev -- aws ssm get-parameter --name "/split-bill/NEXT_PUBLIC_CONVEX_URL" --query Parameter.Value --output text`)
#@required
CONVEX_DEPLOYMENT=exec(`aws-vault exec split-bill-dev -- aws ssm get-parameter --name "/split-bill/CONVEX_DEPLOYMENT" --query Parameter.Value --output text`)

# Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
#@required
CLERK_FRONTEND_API_URL=exec(`aws-vault exec split-bill-dev -- aws ssm get-parameter --name "/split-bill/CLERK_FRONTEND_API_URL" --query Parameter.Value --output text`)
#@sensitive @required
CLERK_SECRET_KEY=exec(`aws-vault exec split-bill-dev -- aws ssm get-parameter --name "/split-bill/CLERK_SECRET_KEY" --with-decryption --query Parameter.Value --output text`)
#@sensitive @required
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=exec(`aws-vault exec split-bill-dev -- aws ssm get-parameter --name "/split-bill/NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY" --with-decryption --query Parameter.Value --output text`)

# Anthropic
#@sensitive @required
ANTHROPIC_API_KEY=exec(`aws-vault exec split-bill-dev -- aws ssm get-parameter --name "/split-bill/ANTHROPIC_API_KEY" --with-decryption --query Parameter.Value --output text`)
#@required
ANTHROPIC_BASE_URL=exec(`aws-vault exec split-bill-dev -- aws ssm get-parameter --name "/split-bill/ANTHROPIC_BASE_URL" --with-decryption --query Parameter.Value --output text`)
#@required
ANTHROPIC_MODEL=exec(`aws-vault exec split-bill-dev -- aws ssm get-parameter --name "/split-bill/ANTHROPIC_MODEL" --with-decryption --query Parameter.Value --output text`)
